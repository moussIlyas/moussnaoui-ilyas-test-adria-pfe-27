# ==============================================================================
#  Repository-wide ignore rules
# ==============================================================================

# --- Secrets / local environment ---------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- JetBrains / IDE ----------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
.springBeans
.sts4-cache
.apt_generated
/shelf/
/workspace.xml
/httpRequests/
/queries/
/dataSources/
/dataSources.local.xml

# --- Java / Maven -------------------------------------------------------------
target/
build/
HELP.md
ebank-ms-app/ebank-bot/src/main/resources/application-local.properties
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*
*.log

# --- Node / React (ebank-web) -------------------------------------------------
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python (python/) ---------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Generated documents / binaries ------------------------------------------
*.pdf

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Compose overrides --------------------------------------------------------
docker-compose.override.yml

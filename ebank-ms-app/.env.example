# All secrets are controlled by .env (gitignored - copy this file to .env and fill in).
# Spring loads .env via spring.config.import=optional:file:../.env in each module's
# application.properties; config-repo/*.properties reference them as ${...} placeholders.
#
# Local dev:  copy this file to .env at the project root, then fill in the values.
#             Services pick them up automatically - no export needed.
# Docker:     `docker compose` reads the same .env automatically for ${...}
#             substitution in docker-compose.yml AND injects it into every
#             container as OS env vars (env_file). Compose refuses to start if
#             the DB_* / MARIADB_ROOT_PASSWORD values are missing.
# CI:         add as repository Settings > Secrets > Actions, then expose with `env:`.
# Deployment: Docker `-e VAR=...` or Kubernetes Secret -> env var.

# Database (used by transaction-service and account-service, dev and pro)
DB_HOST=localhost
DB_USERNAME=ebank
DB_PASSWORD=change-me

# ebank-bot (Ollama cloud + Tavily) - required
OLLAMA_API_KEY=change-me
TAVILY_API_KEY=change-me

# MariaDB root password (docker-compose.yml, first init only)
MARIADB_ROOT_PASSWORD=change-me

# Keycloak bootstrap admin (dev only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Optional: registry prefix/tag used by docker-compose.yml
# IMAGE_PREFIX=registry.example.com/ebank
# IMAGE_TAG=1.2.3
